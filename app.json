{
  "expo": {
    "name": "Touchline",
    "slug": "Touchline",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "touchline",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.muthokaricky.touchline"
    },
    "android": {
      "package": "com.muthokaricky.touchline",
      "adaptiveIcon": {
        "backgroundColor": "#101820",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#101820",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#101820",
    "extra": {
      "eas": {
        "projectId": "577423af-3c3d-4515-9851-4fa462c7d54c"
      }
    },
    "owner": "muthokaricky"
  }
}
