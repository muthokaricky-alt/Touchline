// Cloudflare (Workers with static assets): serves the website built by `npm run build:web`.
// Cloudflare runs `npx wrangler deploy`, which first runs build.command below (so the site is built
// even with no build command set in the dashboard). No Worker script: Cloudflare serves the files in dist/ directly,
// applies dist/_headers, and answers pages that weren't pre-rendered with index.html (the app,
// which then shows the right screen).
{
  "name": "touchline",
  "compatibility_date": "2026-11-16",
  // Builds the website before every deploy (Cloudflare's dashboard build command can stay empty).
  "build": {
    "command": "npm run build:web",
  },
  "assets": {
    "directory": "./dist/",
    "not_found_handling": "single-page-application",
  },
}
