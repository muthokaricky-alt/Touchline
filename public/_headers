# Caching rules for the website. Read by both Netlify and Cloudflare Pages
# (Expo copies public/ into dist/ on export).

# The service worker must always be checked for a new version.
/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: no-cache

# Bundles have a content hash in their names: cache them for a year.
/_expo/static/*
  Cache-Control: public, max-age=31536000, immutable
